# AI Debate Room - Environment Configuration

# Server Port & Host
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# Database Configuration
DATABASE_PATH=./data/debates.db

# LLM Provider Configuration
# Supported providers: "gemini" | "openai" | "groq" | "mock"
# If no API key is provided, the platform automatically uses the High-Fidelity Neural Simulation Engine
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended, free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI / Groq / Open-Source API Key (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq API (Ultra-fast inference, optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
